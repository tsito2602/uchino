{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uchino-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "RECIPE_PHOTOS" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uchino-staging",
      "database_id": "9a27aa3f-5592-4d67-bfb6-86f4a417afef",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "APP_ENV": "staging", "AI_IMPORT_PROVIDER": "cloudflare", "AI_GATEWAY_ID": "uchino" },
  "observability": { "enabled": true }
}
