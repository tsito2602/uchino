{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uchino-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "APP_ENV": "staging" },
  "observability": { "enabled": true }
}
